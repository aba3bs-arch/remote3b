# AM-Connect server
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECRET_KEY=change-this-long-random-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
MIN_PASSWORD_LENGTH=10
ALLOW_REGISTRATION_AFTER_BOOTSTRAP=false
DATABASE_URL=sqlite:///./am_connect.db

# Optional TLS for HTTPS/WSS
USE_SSL=false
SSL_CERT=certs/cert.pem
SSL_KEY=certs/key.pem

# Feature switches
ENABLE_COMMAND_EXECUTION=true
ENABLE_FILE_TRANSFER=true
ENABLE_SCREENSHOTS=true
ENABLE_REMOTE_CONTROL=true
REQUEST_TIMEOUT_SECONDS=45
MAX_UPLOAD_BYTES=26214400

# AM-Connect agent
AM_CONNECT_SERVER_URL=ws://localhost:8000
AM_CONNECT_DEVICE_ID=dev_replace_me
AM_CONNECT_DEVICE_SECRET=secret_replace_me
AM_CONNECT_VERIFY_SSL=true
AM_CONNECT_ALLOW_COMMANDS=true
AM_CONNECT_ALLOW_FILE_TRANSFER=true
AM_CONNECT_ALLOW_SCREENSHOTS=true
AM_CONNECT_ALLOW_REMOTE_CONTROL=true
AM_CONNECT_MAX_DOWNLOAD_BYTES=26214400
