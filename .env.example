# ===== SERVER CONFIGURATION =====
HOST=0.0.0.0
PORT=8000
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== SECURITY =====
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
PUBLIC_URL=http://localhost:8000
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== TLS/SSL =====
USE_SSL=true
SSL_CERT=certs/cert.pem
SSL_KEY=certs/key.pem
SSL_VERIFY=false

# ===== DATABASE =====
DATABASE_URL=sqlite:///./am_connect.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/am_connect

# ===== CLIENT CONFIGURATION =====
SERVER_URL=wss://localhost:8000
DEVICE_ID=device_001
DEVICE_NAME=Default Device
DEVICE_TOKEN=your-device-token-here

# ===== VIDEO RECORDING =====
RECORDING_FPS=30
RECORDING_QUALITY=80
RECORDING_CODEC=mp4v
RECORDING_OUTPUT_DIR=./recordings
MAX_RECORDING_SIZE_MB=500

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=am_connect.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ===== PERFORMANCE =====
WORKER_COUNT=4
KEEP_ALIVE_TIMEOUT=60
CONNECTION_TIMEOUT=30
CHUNK_SIZE=65536

# ===== 2FA SETTINGS =====
TOTP_ISSUER=AM-CONNECT
TOTP_WINDOW=30

# ===== FEATURES =====
ENABLE_FILE_TRANSFER=true
ENABLE_COMMAND_EXECUTION=true
ENABLE_VIDEO_RECORDING=true
ENABLE_CHAT=true
ENABLE_2FA=true
AM_CONNECT_UPLOAD_DIR=client/downloads
